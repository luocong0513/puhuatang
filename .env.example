# ====================================
# 蒲华堂环境变量配置模板
# 复制此文件为 .env.local 并填入实际值
# ====================================

# --- AI 智能体 (蒲生) ---
# 火山引擎/Coze LLM API Key
# 获取地址: https://www.volcengine.com/product/doubao
OPENAI_API_KEY=

# Coze 工作负载 API Token (用于 Coze Web SDK 鉴权)
# 获取地址: Coze 编程项目设置页面
COZE_WORKLOAD_API_TOKEN=

# --- 数据库 (Supabase) ---
# 获取地址: https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 客户端使用 (NEXT_PUBLIC_ 前缀会暴露给浏览器, 用 anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- 数据库连接 (直连 PostgreSQL) ---
DATABASE_URL=

# --- AWS S3 (图片上传, 可选) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=

# --- 应用配置 ---
# 运行环境: development | production
COZE_PROJECT_ENV=development
# 服务端口
PORT=5000
# 主机名
HOSTNAME=localhost
